rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin UID — replace with the owner's Firebase UID to enable cross-user reads.
    // Future: replace with a centreAdmins/{uid} Firestore lookup for tenant admins.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "gWT9Fv74nDPkhATr8f6HWaF9VhH3";
    }

    // User's own document — full read/write for the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      // Allow other authenticated users to modify ONLY the friends array.
      // This enables bidirectional friend linking from the client.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']);

      // Public profile — readable by friends, writable by owner
      match /public/profile {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || (exists(/databases/$(database)/documents/users/$(userId))
                  && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends));
        allow read: if isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Friend code index.
    //
    // `get`, not `read`: `read` covers `list` as well, which let any signed-in
    // user query the whole collection and harvest every code with the uid behind
    // it. `get` still allows the by-ID lookup this is for — both call sites in
    // storage.js (the collision check when generating, and lookupFriendCode) use
    // getDoc on a known code — while denying enumeration.
    //
    // Only the code owner can create their entry, and nobody can change one.
    // The owner can delete theirs — account deletion does (BTL-B32).
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Venues — the shared registry behind the climb logger's venue chips
    // (docs/specs/betalog_venues_spec.md §6).
    //
    // A venue is a public place, so every signed-in user may read the list
    // and run the nearby (geohash prefix) and name (nameKey prefix) queries.
    // Anyone signed in may add one, as themselves, with nobody as admin —
    // adding a venue never claims it. An unplaced venue (no position, added
    // away from the wall) may be placed once by whoever is standing there:
    // the position fields only, only from null. Everything else on a venue
    // is its admins' — the first is set by hand in the console, as the data
    // model always said the first centre admin would be — or the app admin's.
    match /venues/{venueId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.admins == []
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameKey is string
        && request.resource.data.schemaVersion is int;
      allow update: if request.auth != null && (
           isAdmin()
        || (request.auth.uid in resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'nameKey', 'lat', 'lng', 'geohash', 'admins', 'updatedAt']))
        || (resource.data.lat == null
            && request.resource.data.lat is number
            && request.resource.data.lng is number
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lat', 'lng', 'geohash', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // Competitions — docs/specs/betalog_competitions_spec.md §10.
    //
    // The join code is the document ID, so joining is a `get` by a code
    // someone was given and never a `list`. Anyone signed in may create one
    // and becomes its only organiser; only organisers change it. Entrants
    // write their own card, only while the comp is live, and only the card.
    // Scores are never stored — every board is computed from the cards on
    // the client — so there is nothing to forge but one's own goes.
    match /competitions/{code} {
      function compData() {
        return get(/databases/$(database)/documents/competitions/$(code)).data;
      }
      function organises() {
        return request.auth != null && request.auth.uid in compData().organisers;
      }
      function compStatusIn(statuses) {
        return compData().status in statuses;
      }
      // Scoring is open while the comp is running — `live`, or `open` past its
      // stored start (no organiser's phone has moved it on yet) — and before
      // its stored end, if it has one. So cards open and lock on the clock
      // even when no organiser's phone is awake (spec §7d, BTL-B88).
      function scoringOpen() {
        let c = compData();
        let t = request.time.toMillis();
        let started = c.status == 'live'
          || (c.status == 'open' && c.get('startMs', null) != null && t >= c.get('startMs', 0));
        let notEnded = c.get('endMs', null) == null || t < c.get('endMs', 0);
        return started && notEnded;
      }
      function entered() {
        return request.auth != null
          && exists(/databases/$(database)/documents/competitions/$(code)/entries/$(request.auth.uid));
      }

      allow get: if request.auth != null;
      // Only "my comps": the query is where('organisers', 'array-contains', uid).
      allow list: if request.auth != null && request.auth.uid in resource.data.organisers;
      allow create: if request.auth != null
        && request.resource.data.organisers == [request.auth.uid]
        && request.resource.data.status == 'draft'
        && request.resource.data.schemaVersion is int;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.organisers;

      // Hidden grades. Never readable by an entrant; the Close step copies
      // them onto the comp document, which is when they become visible.
      match /private/grades {
        allow read, write: if organises();
      }

      match /entries/{uid} {
        allow read: if entered() || organises();
        allow create: if request.auth != null && request.auth.uid == uid
          && compStatusIn(['open', 'live'])
          && request.resource.data.voids.size() == 0;
        allow update: if request.auth != null && (
             (request.auth.uid == uid && scoringOpen()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['card', 'updatedAt']))
          || (request.auth.uid == uid && compStatusIn(['open'])
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'category', 'updatedAt']))
          || organises()
        );
        allow delete: if request.auth != null
          && ((request.auth.uid == uid && compStatusIn(['open'])) || organises());
      }
    }
  }
}
