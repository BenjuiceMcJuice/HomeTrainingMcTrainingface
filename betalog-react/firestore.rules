rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/centreAdmins/$(request.auth.uid));
    }

    // User's own document — full read/write for the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      // Allow other authenticated users to modify ONLY the friends array.
      // This enables bidirectional friend linking from the client.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']);

      // Public profile — readable by friends, writable by owner
      match /public/profile {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || (exists(/databases/$(database)/documents/users/$(userId))
                  && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends));
        allow read: if isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Friend code index — authenticated users can look up a specific code by ID.
    // List queries are not permitted, preventing enumeration of all codes.
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Centre admins — managed via Firebase console only, not writable from the client.
    match /centreAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
