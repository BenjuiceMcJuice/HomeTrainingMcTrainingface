rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin UID — replace with the owner's Firebase UID to enable cross-user reads.
    // Future: replace with a centreAdmins/{uid} Firestore lookup for tenant admins.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "gWT9Fv74nDPkhATr8f6HWaF9VhH3";
    }

    // User's own document — full read/write for the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      // Allow other authenticated users to modify ONLY the friends array.
      // This enables bidirectional friend linking from the client.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']);

      // Public profile — readable by friends, writable by owner
      match /public/profile {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || (exists(/databases/$(database)/documents/users/$(userId))
                  && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends));
        allow read: if isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Friend code index.
    //
    // `get`, not `read`: `read` covers `list` as well, which let any signed-in
    // user query the whole collection and harvest every code with the uid behind
    // it. `get` still allows the by-ID lookup this is for — both call sites in
    // storage.js (the collision check when generating, and lookupFriendCode) use
    // getDoc on a known code — while denying enumeration.
    //
    // Only the code owner can create their entry, and nobody can change one.
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
